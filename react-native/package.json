{
  "name": "wlab-client-sdk",
  "version": "1.1.4",
  "description": "React Native module for background location tracking. Fork of the Traccar Client SDK for Android and iOS.",
  "main": "./lib/module/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "react-native": "src/index.tsx",
  "source": "src/index.tsx",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "wlab-client-sdk.podspec",
    "!**/build",
    "!**/node_modules"
  ],
  "keywords": [
    "react-native",
    "location",
    "gps",
    "tracking"
  ],
  "repository": "https://github.com/wedderburn-labs/wlab-client-sdk",
  "license": "Apache-2.0",
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "exports": {
    ".": {
      "types": "./lib/typescript/src/index.d.ts",
      "react-native": "./src/index.tsx",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "bob build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "react": "^19.3.0",
    "react-native": "0.87.1",
    "react-native-builder-bob": "^0.43.1",
    "typescript": "^7.0.2"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
